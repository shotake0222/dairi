{
  "name": "sodatsukake",
  "version": "0.1.0",
  "private": true,
  "description": "わけたま（Waketama） - NFCタグ起点・会話育成型キャラクターサービス（Cloudflare Workers / Durable Objects / D1 / Workers AI）",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nfc-companion-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nfc-companion-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tools/e2e.mjs",
    "brand:assets": "python3 tools/make_brand_assets.py"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.0"
  }
}
