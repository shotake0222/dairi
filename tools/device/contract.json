        { "key": "caution", "unit": "0-100", "use": "下がるかどうかの判断" },
        { "key": "independence", "unit": "0-100", "use": "自分から寄るかどうかの判断" },
        { "key": "humor", "unit": "0-100", "use": "—" }
      ]
